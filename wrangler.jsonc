{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smart-farm-rescue",
  "main": "worker.js",
  "compatibility_date": "2026-05-15",
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
